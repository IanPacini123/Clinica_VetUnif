// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Tutor {
    id          Int @id @default(autoincrement())
    nome        String
    cpf         String @unique @db.Char(11)
    telefone    String
    email       String?
    ativo       Boolean @default(true)
    animais     Animal[]

    @@map("tutor")
}

enum Especie {
    CACHORRO
    GATO
    AVE
    ROEDOR
    OUTRO

    @@map("especie")
}

enum Sexo {
    MACHO
    FEMEA

    @@map("sexo")
}

model Animal {
    id              Int @id @default(autoincrement())
    nome            String
    especie         Especie
    raca            String?
    sexo            Sexo
    dataNascimento  DateTime? @db.Date @map("data_nascimento")
    tutorId         Int @map("tutor_id")
    tutor           Tutor @relation(fields: [tutorId], references: [id])
    ativo           Boolean @default(true)
    atendimentos    Atendimento[]

    @@index([tutorId])
    @@map("animal")
}

enum Perfil {
    ADMIN
    ATENDENTE
    VETERINARIO

    @@map("perfil")
}

model Usuario {
    id  Int @id @default(autoincrement())
    nome    String
    nomeUsuario String @unique @map("nome_usuario")
    senhaHash   String @map("senha_hash")
    perfil  Perfil
    crmv    String?
    ativo   Boolean @default(true)
    atendimentos    Atendimento[]

    @@map("usuario")
}

enum StatusAtendimento {
    AGUARDANDO
    EM_ATENDIMENTO
    FINALIZADO
    CANCELADO

    @@map("status_atendimento")
}

model Atendimento {
    id              Int @id @default(autoincrement())
    animalId        Int @map("animal_id")
    animal          Animal @relation(fields: [animalId], references: [id])
    veterinarioId   Int? @map("veterinario_id")
    veterinario     Usuario? @relation(fields: [veterinarioId], references: [id], onDelete: Restrict)
    status          StatusAtendimento @default(AGUARDANDO)
    prioridade      Boolean @default(false)
    queixa          String?
    dataChegada     DateTime @default(now()) @map("data_chegada")
    dataInicio      DateTime? @map("data_inicio")
    dataFim         DateTime? @map("data_fim")
    peso            Decimal? @db.Decimal(5, 2)
    anamnese        String?
    diagnostico     String?
    conduta         String?

    @@index([animalId])
    @@unique([animalId], where: raw("(status = ANY (ARRAY['AGUARDANDO'::status_atendimento, 'EM_ATENDIMENTO'::status_atendimento]))"))
    @@map("atendimento")
}
